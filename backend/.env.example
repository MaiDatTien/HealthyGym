# ==========================================================================
# HealthyGym — Smart AI Gym Platform · Mẫu cấu hình Backend
# Sao chép file này thành `.env` rồi điền giá trị thực tế.
# ==========================================================================

# --- Cơ sở dữ liệu (bắt buộc) ---
# PostgreSQL là mặc định. Có thể dùng SQLite cho môi trường thử nghiệm nhanh:
#   DATABASE_URL=sqlite:///./healthygym.db
DATABASE_URL=postgresql+psycopg://postgres:123@localhost:5432/healthygym

# --- Bảo mật JWT (bắt buộc) ---
# ĐỔI giá trị này khi triển khai thật. Có thể tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=healthygym-super-secret-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==========================================================================
# AI SMART COACH — Cấu hình LLM (TUỲ CHỌN)
# ==========================================================================
# Khi CHƯA cấu hình LLM_API_KEY, chatbot tự động dùng engine rule-based nội bộ:
# website vẫn hoạt động đầy đủ (chẩn đoán, phác đồ, thực đơn) và không cần mạng.
#
# Khi ĐÃ cấu hình, LLM sẽ diễn giải câu trả lời tự nhiên hơn dựa trên
# SYSTEM_INSTRUCTION chuẩn PT/Dinh dưỡng. Các CHỈ SỐ vẫn do engine nội bộ tính
# để đảm bảo luôn khớp với phác đồ đã lưu và biểu đồ tiến độ.

# --- Chọn nhà cung cấp: gemini hoặc openai ---
# LLM_PROVIDER=gemini

# --- API key (bắt buộc để bật LLM) ---
# LLM_API_KEY=

# --- Model (tuỳ chọn; mặc định: gemini-2.0-flash hoặc gpt-4o-mini) ---
# LLM_MODEL=gemini-2.0-flash

# --- Endpoint tuỳ chỉnh cho gateway nội bộ / OpenAI-compatible (tuỳ chọn) ---
# LLM_BASE_URL=

# --- Thời gian chờ mỗi request LLM, giây (tuỳ chọn; mặc định 30) ---
# LLM_TIMEOUT=30